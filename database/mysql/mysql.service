[Unit]
Description=MySQL Server
Documentation=man:mysqld(8)
Documentation=https://dev.mysql.com/doc/refman/en/using-systemd.html
After=network.target

[Install]
WantedBy=multi-user.target

[Service]
# Run mysqld in the foreground (Type=simple); `systemctl start` returns at once and
# readiness is confirmed by the install script's probe. All paths/options live in
# /etc/mysql/my.cnf (pinned via --defaults-file, isolated from stray /etc/my.cnf);
# no pid-file override is passed on the command line.
Type=simple
User=mysql
Group=mysql
ExecStart=/usr/local/mysql/bin/mysqld --defaults-file=/etc/mysql/my.cnf
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStartSec=900
TimeoutStopSec=900
Restart=on-failure
RestartPreventExitStatus=1
PrivateTmp=false
LimitNOFILE=10000
